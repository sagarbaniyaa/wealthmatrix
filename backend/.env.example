NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=wealthmatrix_app
DB_PASSWORD=changeme
DB_DATABASE=Wealthmatrix
# IMPORTANT: this DB role must NOT have BYPASSRLS — see schema notes.

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Encrypts stored secrets at rest (currently: an adviser's IMAP app
# password for Email Sync). Any random long string.
ENCRYPTION_KEY=replace-with-a-long-random-string

# Provider Automation Hub — outgoing email for "Send to Provider".
# Leave SMTP_HOST unset to run without email configured: packs still
# generate, but a send logs a FAILED compliance_provider_actions row with
# a clear reason instead of silently pretending to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourfirm.com

# Nightly fund-import job (Fund Research Module) — leave unset to skip it.
FUND_DATA_SOURCE_URL=
