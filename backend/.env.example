NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=wealthmatrix_app
DB_PASSWORD=changeme
DB_DATABASE=Wealthmatrix
# IMPORTANT: this DB role must NOT have BYPASSRLS — see schema notes.

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Encrypts stored secrets at rest (currently: an adviser's IMAP app
# password for Email Sync). Any random long string.
ENCRYPTION_KEY=replace-with-a-long-random-string

# Provider Automation Hub — outgoing email for "Send to Provider".
# Leave SMTP_HOST unset to run without email configured: packs still
# generate, but a send logs a FAILED compliance_provider_actions row with
# a clear reason instead of silently pretending to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourfirm.com

# Nightly fund-import job (Fund Research Module) — leave unset to skip it.
FUND_DATA_SOURCE_URL=

# Telephony — real outbound calling ("Call Client"). Leave unset to run
# without it: the button returns a clear "not configured" error instead
# of pretending to dial. Setup (you create this account yourself — we
# can't do it on your behalf):
#   1. Sign up at twilio.com (free trial includes credit).
#   2. Console dashboard -> copy Account SID and Auth Token below.
#   3. Buy a phone number (Phone Numbers -> Buy a number, Voice-capable)
#      -> paste it below in E.164 format, e.g. +14155550100.
#   4. Set BACKEND_PUBLIC_URL to this backend's real public URL (e.g.
#      https://wealthmatrix-backend.onrender.com, no trailing slash) —
#      Twilio needs to reach this server to report call status back.
# On the free trial, Twilio can only call phone numbers you've verified
# in the console (Phone Numbers -> Verified Caller IDs) — verify both
# the adviser's and the test client's numbers before trying "Call Client".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
BACKEND_PUBLIC_URL=

# Error monitoring (Sentry, free tier). Leave unset to run without it —
# the app works exactly the same either way, it just has no automatic
# alert when something breaks. Setup:
#   1. Sign up free at sentry.io (no card required for the free tier).
#   2. Create a project (platform: Node.js / NestJS).
#   3. Copy the DSN it gives you (looks like https://xxx@xxx.ingest.sentry.io/xxx).
# Only genuinely unexpected errors are reported (an unhandled exception,
# or a database error this backend doesn't recognise) — never routine
# 400/401/403/404 responses, which are expected application flow.
SENTRY_DSN=
